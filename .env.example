# Copy to .env.local for local dev. Add the same values in Vercel > Project > Settings > Environment Variables.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# anon key or the newer "publishable" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key or the newer "secret" key. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database > Connection string (Session pooler, URI). Used only by scripts/*.py
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- LLM + embeddings (both free tiers) ---
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional overrides
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_SAFETY_MODEL=openai/gpt-oss-safeguard-20b

# --- Demo accounts (created by scripts/seed_users.py) ---
DEMO_PASSWORD=change-me-to-something-long
# true = login page shows one-click role buttons (password stays on the server)
DEMO_MODE=true

# --- Guardrail tuning ---
PROMPT_GUARD_THRESHOLD=0.9
SCOPE_SIMILARITY_THRESHOLD=0.6
RESTRICTED_SIMILARITY_THRESHOLD=0.68
RATE_LIMIT_PER_MINUTE=12

# --- Cost monitoring (shadow pricing: what this traffic would cost on a paid model) ---
SHADOW_PRICE_INPUT_PER_M=1.25
SHADOW_PRICE_OUTPUT_PER_M=10
MONTHLY_BUDGET_USD=20

# --- Observability + alerts (optional; features switch off when empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
DISCORD_WEBHOOK_URL=
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to cron routes
CRON_SECRET=
